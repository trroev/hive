{
  "hiveProfileVersion": 1,
  "trunk": "main",
  "gates": {
    "invariants": "bash scripts/check-invariants.sh"
  },
  "sharedSurfaces": [
    "skills/run/SKILL.md",
    "scripts/check-invariants.sh",
    "CONTEXT.md",
    "README.md",
